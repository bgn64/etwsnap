<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.21" />
    <PackageReference Include="Microsoft.Performance.SDK" Version="1.2.2-preview" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\..\src\EtwSnap.Artifacts\EtwSnap.Artifacts.csproj" />
    <ProjectReference Include="..\..\src\EtwSnap.Contracts\EtwSnap.Contracts.csproj" />
    <ProjectReference Include="..\..\src\EtwSnap.Host\EtwSnap.Host.csproj" />
    <ProjectReference Include="..\..\src\EtwSnap.WpaPlugin\EtwSnap.WpaPlugin.csproj" />
  </ItemGroup>
  <Target Name="CopyNativeCapture" AfterTargets="Build" Condition="Exists('..\..\x64\$(Configuration)\EtwSnap.Native.dll')">
    <Copy SourceFiles="..\..\x64\$(Configuration)\EtwSnap.Native.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
