<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>etwsnap</AssemblyName>
    <RootNamespace>EtwSnap.Cli</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <ProjectReference Include="..\EtwSnap.Contracts\EtwSnap.Contracts.csproj" />
    <ProjectReference Include="..\EtwSnap.Host\EtwSnap.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyHostArtifacts" AfterTargets="Build">
    <PropertyGroup>
      <HostPlatformPath Condition="'$(Platform)' == 'x64'">x64\</HostPlatformPath>
    </PropertyGroup>
    <ItemGroup>
      <HostArtifact Include="..\EtwSnap.Host\bin\$(HostPlatformPath)$(Configuration)\net10.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(HostArtifact)" DestinationFiles="@(HostArtifact->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
