#include <windows.h>

#define ETWSNAP_STRINGIZE_IMPL(value) #value
#define ETWSNAP_STRINGIZE(value) ETWSNAP_STRINGIZE_IMPL(value)
#define ETWSNAP_VERSION_STRING \
    ETWSNAP_STRINGIZE(ETWSNAP_VERSION_MAJOR) "." \
    ETWSNAP_STRINGIZE(ETWSNAP_VERSION_MINOR) "." \
    ETWSNAP_STRINGIZE(ETWSNAP_VERSION_PATCH) "." \
    ETWSNAP_STRINGIZE(ETWSNAP_VERSION_BUILD)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ETWSNAP_VERSION_MAJOR,ETWSNAP_VERSION_MINOR,ETWSNAP_VERSION_PATCH,ETWSNAP_VERSION_BUILD
 PRODUCTVERSION ETWSNAP_VERSION_MAJOR,ETWSNAP_VERSION_MINOR,ETWSNAP_VERSION_PATCH,ETWSNAP_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ETWSnap contributors\0"
            VALUE "FileDescription", "ETWSnap native capture engine\0"
            VALUE "FileVersion", ETWSNAP_VERSION_STRING "\0"
            VALUE "InternalName", "EtwSnap.Native.dll\0"
            VALUE "LegalCopyright", "Copyright (c) ETWSnap contributors\0"
            VALUE "OriginalFilename", "EtwSnap.Native.dll\0"
            VALUE "ProductName", "ETWSnap\0"
            VALUE "ProductVersion", ETWSNAP_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END