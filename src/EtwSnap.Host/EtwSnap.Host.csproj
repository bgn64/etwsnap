<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>etwsnap.host</AssemblyName>
    <RootNamespace>EtwSnap.Host</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseSystemDrawing>true</UseSystemDrawing>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <ProjectReference Include="..\EtwSnap.Contracts\EtwSnap.Contracts.csproj" />
    <ProjectReference Include="..\EtwSnap.Native\EtwSnap.Native.vcxproj" ReferenceOutputAssembly="false" Condition="'$(SkipNativeBuild)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\profiles\EtwSnap.wprp" Link="profiles\EtwSnap.wprp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyNativeCapture" AfterTargets="Build" Condition="Exists('..\..\x64\$(Configuration)\EtwSnap.Native.dll')">
    <Copy SourceFiles="..\..\x64\$(Configuration)\EtwSnap.Native.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
